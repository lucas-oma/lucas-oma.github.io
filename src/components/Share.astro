---
import { siteConfig } from '@/data/site.config'
import XColorIcon from './icons/XColorIcon.astro'
import XAltColorIcon from './icons/XAltColorIcon.astro'
import LinkedinColorIcon from './icons/LinkedinColorIcon.astro'
const message = siteConfig.shareMessage

const URL = Astro.url.href
const path = Astro.url.pathname
const { text } = Astro.props
---

<div class='flex flex-col gap-2'>
	<span class='mb-1 font-bold text-2xl'>Share</span>
	<ul class='flex gap-3 text-black dark:text-white'>
		<li>
			<a
				target="_blank" rel="noopener noreferrer" data-umami-event=`shareX_${path}`
				href={`https://x.com/intent/post?text=${message}%0A${text}%20•%20${siteConfig.title}&url=${URL}`}

				aria-label='Share on X'>
					<span id="light-x-icon" style="display: none;">
						<XColorIcon  />
					</span>
					<span id="dark-x-icon" style="display: none;">
						<XAltColorIcon />
				  </span>
			</a>
		</li>
		<li>
			<a
				target="_blank" rel="noopener noreferrer"  data-umami-event=`shareLinkedIn_${path}`
				href={`https://www.linkedin.com/shareArticle?mini=true&url=${URL}`}
				aria-label='Share on LinkedIn'
			>
				<LinkedinColorIcon /></a
			>
		</li>
	</ul>
</div>


<script>
	function updateXIconVisibility() {
	  const isDark = document.documentElement.classList.contains('dark');
	  const lightIcon = document.getElementById('light-x-icon');
	  const darkIcon = document.getElementById('dark-x-icon');
  
	  if (lightIcon && darkIcon) {
		lightIcon.style.display = isDark ? 'none' : 'block';
		darkIcon.style.display = isDark ? 'block' : 'none';
	  }
	}
  
	// Initial render
	updateXIconVisibility();
  
	// When theme is toggled (you already emit this event)
	document.addEventListener('theme-change', () => {
	  updateXIconVisibility();
	});
  
	// Astro navigation reload
	document.addEventListener('astro:page-load', () => {
	  updateXIconVisibility();
	});
  </script>
  