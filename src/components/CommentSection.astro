<script>
    function renderGiscus(theme: String) {
        const giscusContainer = document.querySelector('.giscus');

        if (giscusContainer) {
            giscusContainer.innerHTML = ''; // Clear existing content

            const giscusScript = document.createElement('script');
            giscusScript.setAttribute('src', 'https://giscus.app/client.js');
            giscusScript.setAttribute('data-repo', 'lucas-oma/lucas-oma.github.io');
            giscusScript.setAttribute('data-repo-id', 'R_kgDON4qjlQ');
            giscusScript.setAttribute('data-category', 'Blog Post Comments');
            giscusScript.setAttribute('data-category-id', 'DIC_kwDON4qjlc4CnTab');
            giscusScript.setAttribute('data-mapping', 'url');
            giscusScript.setAttribute('data-strict', '0');
            giscusScript.setAttribute('data-reactions-enabled', '1');
            giscusScript.setAttribute('data-emit-metadata', '0');
            giscusScript.setAttribute('data-input-position', 'bottom');
            giscusScript.setAttribute('data-theme', theme === 'dark' ? 'transparent_dark' : 'light');
            giscusScript.setAttribute('data-lang', 'en');
            giscusScript.setAttribute('data-loading', 'lazy');
            giscusScript.setAttribute('crossorigin', 'anonymous');

            giscusContainer.appendChild(giscusScript);
        }
    }

    function getCurrentTheme() {
        return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    }

    function initGiscus() {
        const theme = getCurrentTheme();
        renderGiscus(theme);
    }

    // Initial load
    initGiscus();

    // When theme is changed
    document.addEventListener('theme-change', (event) => {
        const customEvent = event as CustomEvent<{ theme: string }>;
        const theme = customEvent.detail.theme;
        renderGiscus(theme);
    });


    // When navigating to a new route (Astro client routing)
    document.addEventListener('astro:page-load', () => {
        initGiscus();
    });
</script>



<section class="mx-auto mt-10 w-full">
    <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200">Comments</h2>
    <hr class="my-4 border-gray-300 dark:border-gray-600">
    <div class="giscus"></div>
</section>