---
import BaseLayout from '@/layouts/BaseLayout'
import { profileData } from '@/data/profile'
import { SOCIALNETWORKS } from '@/data/links'
import PageViews from '@/components/PageViews'

const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).href;

const { name, avatar, resumeLink, publications, projects } = profileData
---

<BaseLayout title="About Me">
  <!-- Meta Tags for SEO -->
  <head>
    <meta name="description" content="Get to know me!" />
    <meta property="og:title" content="About Me" />
    <meta property="og:description" content="Get to know me!" />
    <meta property="og:image" content={avatar} />
    <meta property="og:type" content="website" />
  </head>

  <div class="relative max-w-3xl mx-auto px-4">
    
    <!-- Floating Sidebar Index (Aligned with Logo & Lowered) -->
    <nav class="hidden lg:block fixed top-32 left-[calc(12vw)] w-48">
      <ul class="space-y-4 text-sm text-gray-600 dark:text-gray-400">
        <li>
          <a href="#about" class="hover:text-blue-500">About Me</a>
        </li>
        <li>
          <a href="#publications" class="hover:text-blue-500">Publications</a>
        </li>
        <li>
          <a href="#projects" class="hover:text-blue-500">Projects & Research</a>
        </li>
      </ul>
    </nav>

    <!-- About Me Section-->
    <section id="about" class="flex flex-col items-center text-center mt-12 mb-6">
      <img src={avatar} alt={name} class="w-40 h-40 rounded-full shadow-lg mb-4" />
      <h1 class="text-3xl font-bold">{name}</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">M.S. in Computer Science, AI Concentration - New York University, Courant</p>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mt-2">
      I'm an AI enthusiast 🤖 who enjoys solving complex problems, exploring how things work, and creating efficient solutions. Whether I’m experimenting with AI models, researching new ideas, optimizing code, or contributing to open-source projects, I enjoy pushing boundaries and constantly learning.
      </p>

      <!-- Social Links -->
      <div class="flex gap-4 mt-4">
        {SOCIALNETWORKS.map((network) => (
          <a href={network.url} target="_blank" class="text-blue-500 hover:underline" aria-label={network.name}
          data-umami-event={`SocialNetwork_${network.name}`}>
            {<network.icon />}
          </a>
        ))}
      </div>

      <!-- Resume & Blog -->
      <div class="flex gap-4 mt-4">
        {resumeLink && (
          <a href={resumeLink} target="_blank" rel="noopener noreferrer" data-umami-event="view_resume_btn"
            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
            View Resume
          </a>
        )}
        <a href="/" class="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition">
          Read Blog
        </a>
      </div>
    </section>

    <!-- My Stack -->
    <!-- <div class="flex flex-col items-center space-y-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">

        <div class="p-2 flex flex-col items-center bg-gray-800 text-white rounded-md shadow-md">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" class="w-5 h-5 mb-1">
          <span class="text-xs">Python</span>
        </div>

        <div class="p-2 flex flex-col items-center bg-gray-800 text-white rounded-md shadow-md">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cplusplus/cplusplus-original.svg" class="w-5 h-5 mb-1">
          <span class="text-xs">C++</span>
        </div>
        
        <div class="p-2 flex flex-col items-center bg-gray-800 text-white rounded-md shadow-md">
          <img src="https://upload.wikimedia.org/wikipedia/commons/1/10/PyTorch_logo_icon.svg" class="w-5 h-5 mb-1">
          <span class="text-xs">PyTorch</span>
        </div>

        <div class="p-2 flex flex-col items-center bg-gray-800 text-white rounded-md shadow-md">
          <img src="https://upload.wikimedia.org/wikipedia/commons/2/2d/Tensorflow_logo.svg" class="w-5 h-5 mb-1">
          <span class="text-xs">TensorFlow</span>
        </div>
      </div> -->
    
    <!-- Publications -->
    <section id="publications" class="mt-12">
      <h2 class="text-2xl font-semibold mt-12 mb-6 text-center">📚 Publications 📚</h2>
      <ul class="space-y-6">
        {publications.map((pub) => (
          <li class="border-b border-gray-300 pb-4">
            <h3 class="text-lg font-semibold">
              <a href={pub.url} target="_blank" class="text-blue-500 hover:underline" 
              data-umami-event={`publication_${pub.title}`}>
                {pub.title}
              </a>
            </h3>
            <p class="text-sm text-gray-500 italic">{pub.publisher}</p>
            <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">{pub.abstract}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Projects & Research -->
    <section id="projects" class="mt-12">
      <h2 class="text-2xl font-semibold mt-12 mb-6 text-center">🔬 Projects and Research 🔬</h2>
      <ul class="space-y-6">
        {projects
          .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
          .map((proj) => (
            <li class={`border-b border-gray-300 pb-4 flex ${proj.image ? "items-start space-x-4" : "flex-col"}`}>
              <!-- Square Image (Only If Exists) -->
              {proj.image && (
                <img 
                  src={proj.image} 
                  alt={`Thumbnail for ${proj.title}`} 
                  class="w-[5lh] h-[5lh] object-cover rounded-md shadow-md"
                />
              )}

              <!-- Project Content -->
              <div class="flex-1">
                <h3 class="text-lg font-semibold">{proj.title}</h3>
                {proj.date && (
                  <p class="text-xs text-gray-500 mt-1">{new Date(proj.date).toLocaleDateString()}</p>
                )}
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">{proj.description}</p>
                <div class="flex space-x-4 mt-2">
                  {proj.pdf && (
                    <a href={proj.pdf} target="_blank" class="text-blue-500 text-sm hover:underline"
                    data-umami-event={`PDF_project_${proj.title}`}>
                      📄 PDF
                    </a>
                  )}
                  {proj.github && (
                    <a href={proj.github} target="_blank" class="text-blue-500 text-sm hover:underline"
                    data-umami-event={`GITHUB_project_${proj.title}`}>
                      🔗 GitHub
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))}
      </ul>
    </section>

    <div class="mt-12">
      <PageViews url={pageUrl}, margin="c" />
    </div>
   
  </div>


</BaseLayout>
